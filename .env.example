# Copy this file to .env.local and replace the placeholders.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_SECOND_GEMINI_API_KEY
SUPADATA_API_KEY=YOUR_SUPADATA_API_KEY

# Grounded fact-checking model pool. Keep this to models that support Google
# Search grounding for generateContent.
GEMINI_MODEL_POOL=gemini-2.5-flash-lite:4,gemini-2.5-flash:1
SUPADATA_API_URL=https://api.supadata.ai/v1/transcript
