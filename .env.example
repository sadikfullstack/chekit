# Copy this file to .env.local and replace the placeholders.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_API_KEY_2=YOUR_SECOND_GEMINI_API_KEY
SUPADATA_API_KEY=YOUR_SUPADATA_API_KEY

# Weighted model pool. 3.1 carries ~88% of unique scans; both 2.5 models are
# spread through the remaining traffic and automatically take over on cooldown.
GEMINI_MODEL_POOL=gemini-3.1-flash-lite:15,gemini-2.5-flash-lite:1,gemini-2.5-flash:1
SUPADATA_API_URL=https://api.supadata.ai/v1/transcript
